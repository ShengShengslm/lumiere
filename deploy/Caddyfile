43-156-145-27.sslip.io {
	@eventStream path /api/sessions/*/chat
	handle @eventStream {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
}
