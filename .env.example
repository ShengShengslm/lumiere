PORT=3000
HOST=127.0.0.1
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
APP_ACCESS_TOKEN=

# Apple Health Auto Export webhook
HEALTH_SYNC_TOKEN=
HEALTH_DB_PATH=/opt/lumiere/data/health.sqlite
HEALTH_RETENTION_DAYS=3

# Supabase: server only. Never put the service-role key in browser files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude Code through your own official Claude subscription. Generate this
# later with `claude setup-token`; never send or commit the token.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_MODEL=claude-sonnet-4-6
CLAUDE_CODE_MAX_BUDGET_USD=0.25

# OpenAI official Responses API
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_SAFETY_IDENTIFIER=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_PRO_MODEL=gpt-5.6-sol

# Anthropic official Messages API (separate from Claude.ai subscription)
ANTHROPIC_API_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_FAST_MODEL=claude-haiku-4-5
ANTHROPIC_PRO_MODEL=claude-opus-4-8

# DeepSeek OpenAI-compatible API
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# Optional OpenAI-compatible relay. Comma-separated model IDs.
CUSTOM_PROVIDER_LABEL=兼容中转
CUSTOM_API_URL=
CUSTOM_API_KEY=
CUSTOM_MODELS=

# Long-term memory compression. Falls back to the first configured provider.
MEMORY_PROVIDER=deepseek
MEMORY_MODEL=deepseek-chat

# Optional Ombre Brain MCP memory service. A local VPS deployment can use
# http://127.0.0.1:18001. Keep the token server-side when remote auth is used.
OMBRE_BRAIN_URL=
OMBRE_BRAIN_VAULT_PATH=
OMBRE_BRAIN_TOKEN=
OMBRE_BRAIN_TIMEOUT_MS=3000
OMBRE_BRAIN_MAX_RESULTS=5
OMBRE_BRAIN_CATALOG_MAX_TOKENS=3000
OMBRE_ALLOW_CLAUDE_HOLD=true

# ElevenLabs voice cache. Identical voice messages are synthesized only once.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_CACHE_PATH=/opt/lumiere/data/voice-cache
ELEVENLABS_CACHE_RETENTION_DAYS=14

# Proactive shadow messages. Keep PUSH_SECRET and BARK_URL server-side.
PUSH_SECRET=
PUSH_MODEL_SELECTION=claude-code:claude-sonnet-4-6
PUSH_COOLDOWN_MIN_MINUTES=30
PUSH_COOLDOWN_MAX_MINUTES=120
BARK_URL=
PUBLIC_APP_URL=https://43-156-145-27.sslip.io
PUSH_TITLE=顾克
BARK_ICON_URL=https://43-156-145-27.sslip.io/app-icon-512.png
